{
    "name": "codeling/bfstop",
    "description": "Brute Force Stop for Joomla! - this file tracks the third-party code vendored into the package (library/src/Helper/Geo, see README.md) and the development tools (phpstan)",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "maxmind-db/reader": "^1.14.0"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "vendor-geoip": "@php tools/vendor-geoip.php",
        "check-geoip": "@php tools/vendor-geoip.php --check"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    }
}
