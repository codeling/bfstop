# Static analysis, see tests/README.md ("Static analysis").
#
#   JOOMLA_ROOT=/path/to/joomla php vendor/bin/phpstan analyse
#
# Joomla has no stubs package; instead its own code (libraries/) is scanned
# from an unpacked full package, so the types are those of the real release.
# CI uses tests/ci/phpstan.sh, which downloads and verifies one.
includes:
	- phpstan-baseline.neon

parameters:
	level: 5
	# the oldest PHP the extensions support (composer.json)
	phpVersion: 80200
	paths:
		- library/src
		- plugin/src
		- component/admin/src
		- component/site/src
		- quickicon/src
		- console/src
	excludePaths:
		analyse:
			# generated from maxmind-db/reader by tools/vendor-geoip.php: scanned
			# (the classes are used), not analysed
			- library/src/Helper/Geo
	bootstrapFiles:
		- tests/phpstan/bootstrap.php
	scanDirectories:
		- %env.JOOMLA_ROOT%/libraries
		# the event of the quick icons (Joomla\Module\Quickicon\...) is the module's
		- %env.JOOMLA_ROOT%/administrator/modules/mod_quickicon/src
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# a form rule returns true, false - or the error to show, as an
		# exception: Joomla's Form::validateField() takes that ("if ($valid
		# instanceof \Exception)"), though FormRule::test() says it returns bool
		-
			identifier: return.type
			message: '#^Method Codeling\\Component\\Bfstop\\Administrator\\Rule\\\w+Rule::test\(\) should return bool but returns UnexpectedValueException\.$#'
			path: component/admin/src/Rule/*
